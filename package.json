{
  "name": "cyt-dashboard",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npx vercel dev --listen 3000",
    "dev:static": "python3 -m http.server 8000",
    "seguimiento": "node run.js",
    "seguimiento:solo-nuevos": "node run.js --solo-nuevos",
    "seguimiento:ultimo": "node run.js --ultimo",
    "seguimiento:recientes": "node run.js --recientes=7",
    "sync:dashboard-data": "node scripts/sync-dashboard-data.mjs",
    "broadcast": "node broadcast.js",
    "test": "node --test tests/*.test.js",
    "test:py": "python3 -m unittest discover -s tests"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "cheerio": "^1.0.0",
    "pdf-parse": "^1.1.1",
    "resend": "^6.9.0"
  }
}
